{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:clean": "cmd /c \"taskkill /F /IM emulator.exe /T >nul 2>&1 & taskkill /F /IM qemu-system-x86_64.exe /T >nul 2>&1 & taskkill /F /IM adb.exe /T >nul 2>&1 & %LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe start-server & start \"\" %LOCALAPPDATA%\\Android\\Sdk\\emulator\\emulator.exe -avd Medium_Phone_API_36.1 -no-snapshot-load & timeout /t 10 >nul & expo start --android\"",
    "android:stable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./run-android-stable.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@lottiefiles/dotlottie-react-native": "^0.7.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~55.0.5",
    "expo-constants": "~55.0.7",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.5",
    "expo-sensors": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "lottie-react-native": "~7.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
